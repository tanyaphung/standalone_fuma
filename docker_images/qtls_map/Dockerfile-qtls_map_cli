FROM python:3

WORKDIR /app

COPY qtls_map/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

RUN apt-get update && apt-get install -y \
    --no-install-recommends build-essential r-base \
    libcurl4-openssl-dev \
    libssl-dev \
    libxml2-dev \
    libarmadillo-dev \
    liblapack-dev \
    libblas-dev \
    gfortran \
    build-essential 

COPY app.config ./
COPY qtls_map/qtl_map_helpers.py ./qtl_map_helpers.py
COPY qtls_map/config_helpers.py ./config_helpers.py
COPY qtls_map/qtl_map.py ./qtl_map.py